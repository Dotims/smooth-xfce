#!/bin/bash
# Toggles the quick settings popup; starts it on first use (`--daemon` starts it hidden).
if [ "$1" != --daemon ]; then
  gdbus call --session --dest dev.dotims.QuickSettings --object-path /dev/dotims/QuickSettings \
    --method org.freedesktop.Application.Activate '{}' >/dev/null 2>&1 && exit 0
fi
exec python3 ~/.local/share/desktop-look/quick_settings.py "$@"
