#!/bin/bash
# genmon: the status button image drawn by the quick settings daemon; click opens quick settings.
d="${XDG_RUNTIME_DIR:-/tmp}/status-icons"
if [ ! -f "$d/icons.png" ]; then
  pgrep -f '^python3 [^ ]*desktop-look/quick_settings.py' >/dev/null || \
    setsid "$HOME/.local/bin/quick-settings" --daemon >/dev/null 2>&1 < /dev/null &
  echo "<txt>…</txt><txtclick>$HOME/.local/bin/quick-settings</txtclick>"; exit 0
fi
echo "<img>$d/icons.png</img>"
echo "<click>$HOME/.local/bin/quick-settings</click>"
echo "<tool>$(cat "$d/tooltip" 2>/dev/null)</tool>"
