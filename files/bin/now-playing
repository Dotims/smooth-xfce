#!/bin/bash
# genmon: current Spotify track in the panel; click toggles play/pause, empty when Spotify is off.
# a fixed 300 px slot keeps the centred dock still when the title changes or Spotify quits
slot='.genmon_valuebutton { min-width: 300px; padding: 0 10px; border-radius: 10px; }'
st=$(playerctl -p spotify status 2>/dev/null) || { echo "<txt></txt><css>$slot</css>"; exit; }
t=$(playerctl -p spotify metadata title 2>/dev/null); a=$(playerctl -p spotify metadata artist 2>/dev/null)
esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }
line="$t · $a"; [ ${#line} -gt 42 ] && line="${line:0:41}…"
line=$(printf '%s' "$line" | esc)
if [ "$st" = Playing ]; then icon="♪"; color="#c0caf5"; else icon="⏸"; color="#7a83ad"; fi
echo "<txt><span font='Inter Medium 10' foreground='$color'>$icon  $line</span></txt>"
echo "<txtclick>playerctl -p spotify play-pause</txtclick>"
echo "<css>$slot .genmon_valuebutton { background-color: rgba(255, 255, 255, 0.05); }</css>"
printf '<tool>%s\n%s\n\nClick: pause / play. Next and previous: media keys.</tool>\n' "$(printf '%s' "$t" | esc)" "$(printf '%s' "$a" | esc)"
