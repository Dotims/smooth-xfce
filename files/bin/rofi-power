#!/bin/bash
# rofi script mode: power menu with confirmation for restart/shutdown/logout.
case "$*" in
  "") printf '%s\n' "󰌾  Zablokuj" "󰒲  Uśpij" "󰋊  Hibernuj" "󰍃  Wyloguj" "󰜉  Uruchom ponownie" "󰐥  Wyłącz";;
  *Zablokuj) setsid ~/.local/bin/lock-now >/dev/null 2>&1 & ;;
  *Uśpij) systemctl suspend ;;
  *Hibernuj) systemctl hibernate ;;
  *"Wyloguj") printf '%s\n' "Tak, wyloguj" "Anuluj";;
  *"Uruchom ponownie") printf '%s\n' "Tak, uruchom ponownie" "Anuluj";;
  *"Wyłącz") printf '%s\n' "Tak, wyłącz" "Anuluj";;
  "Tak, wyloguj") xfce4-session-logout --logout --fast >/dev/null 2>&1 & ;;
  "Tak, uruchom ponownie") systemctl reboot ;;
  "Tak, wyłącz") systemctl poweroff ;;
  *) ;;
esac
