// Tokyo Night system summary; run `fastfetch`
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "color": { "1": "38;2;122;162;247", "2": "38;2;187;154;247" },
    "padding": { "top": 1, "left": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;122;162;247", "title": "38;2;187;154;247", "separator": "38;2;86;95;137" },
    "key": { "width": 10 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}@{host-name-colored}" },
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "󰣇 os", "format": "{pretty-name}" },
    { "type": "kernel", "key": " kernel" },
    { "type": "de", "key": " desktop", "format": "{pretty-name} {version}" },
    { "type": "wm", "key": " wm", "format": "{pretty-name}" },
    { "type": "theme", "key": "󰉼 theme" },
    { "type": "terminal", "key": " term" },
    { "type": "shell", "key": " shell" },
    { "type": "packages", "key": "󰏖 pkgs" },
    { "type": "memory", "key": " memory" },
    { "type": "uptime", "key": "󰅐 uptime" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
