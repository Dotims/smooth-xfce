configuration {
  modi: "drun,window,filebrowser,calc,emoji";
  show-icons: true;
  icon-theme: "Qogir-Dark";
  display-drun: "Apps";
  display-window: "Windows";
  display-filebrowser: "Files";
  display-calc: "Calculator";
  display-emoji: "Emoji";
  display-power: "Power";
  display-dmenu: "Clipboard";
  drun-display-format: "{name}";
  matching: "fuzzy";
  sort: true;
  sorting-method: "fzf";
  disable-history: false;
  kb-mode-next: "Tab";
  kb-mode-previous: "ISO_Left_Tab";
  kb-row-tab: "";
  kb-element-next: "";
  kb-element-prev: "";
}
@theme "~/.config/rofi/spotlight.rasi"
